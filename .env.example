# Copy to .env for local work. On Railway, set these under the service's Variables tab.

# Railway adds this automatically when you reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///./doai.db
# Optional: a Postgres role with SELECT-only rights, used for SQL written by Claude
DATABASE_URL_READONLY=

# From console.anthropic.com. Leave empty to run without Claude (detection still works).
ANTHROPIC_API_KEY=
DOAI_REASONING_MODEL=claude-sonnet-5-5
DOAI_FAST_MODEL=claude-haiku-5-5

# Shared token protecting /api/* in the demo. Generate a long random value.
DOAI_API_TOKEN=

# Load synthetic demo data on first start if the database is empty
DOAI_SEED_ON_START=true
# Allow the "Load demo data" button (turn off once real data is loaded)
DOAI_ALLOW_SEED=true
DOAI_ANOMALY_Z=3.0
