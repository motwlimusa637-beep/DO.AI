{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["doai/**", "requirements.txt", "Dockerfile", "railway.worker.json"]
  },
  "deploy": {
    "startCommand": "python -m doai.jobs pipeline --limit 5",
    "cronSchedule": "5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
